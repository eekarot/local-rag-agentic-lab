# ============================================================================
# 本地 RAG 的全部可调开关（每一行都是「变量名=默认值」，复制成 .env 即可生效）
#
#   cp .env.example .env        # Windows: copy .env.example .env
#
# 本仓库**不自动读取 .env**（刻意：少一个隐式依赖）。两种用法：
#   1. 手动导出：PowerShell 里 `$env:OLLAMA_CHAT_MODEL="qwen3.5:9b"`；
#   2. 自己加 python-dotenv，或 `set -a; source .env; set +a`（bash）。
# 值是默认值时可以不写；本文件只是把默认值摊开给你看。
#
# 集合校验：tests/test_dev_env_manifest.py 会断言「代码读的变量」与「本文件写的
# 变量」两边差集为空 —— 加了开关没写这里，或用例里多写了不存在的开关，都会挂。
# ============================================================================

# ---------------------------------------------------------------------------
# 路径：数据放哪、索引放哪（相对路径按**启动目录**解析，脚本建议写绝对路径；
# 不设时 = 仓库根目录下的 data / storage / logs）
# ---------------------------------------------------------------------------
RAG_DATA_DIR=data
RAG_STORAGE_DIR=storage

# ---------------------------------------------------------------------------
# Ollama：三处硬依赖（query 向量 / 中英翻译 / 生成）共用同一个服务
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3.5:9b
OLLAMA_EMBED_MODEL=bge-m3

# ---------------------------------------------------------------------------
# 向量库：地址 + 版本纪律（镜像 minor 必须与 qdrant-client 的 minor 对齐）
# ---------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333

# ---------------------------------------------------------------------------
# 切分与词表：改 CHUNK_SIZE/CHUNK_OVERLAP 必须重建索引（父块与子块都会变）
# ---------------------------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=80
RAG_TOKENIZER_PATH=storage/tokenizer/tokenizer.json

# ---------------------------------------------------------------------------
# 向量调用：单批条数太大容易吃 400（runner 重启），build_index 会自动重试
# ---------------------------------------------------------------------------
EMBED_BATCH_SIZE=256
EMBED_400_RETRIES=3
EMBED_400_BACKOFF=1.0
RAG_EMBED_MAX_CHARS=8192
RAG_EMBED_CACHE=storage/cache/embeddings.sqlite3

# ---------------------------------------------------------------------------
# 检索与融合：BM25 参数 / RRF 常数 / 加权融合权重（只在 hybrid_score 模式下用）
# ---------------------------------------------------------------------------
TOP_K=4
BM25_K1=1.5
BM25_B=0.75
RRF_K=60
HYBRID_ALPHA=0.5
MAX_AGENT_STEPS=4

# ---------------------------------------------------------------------------
# 降级熔断：向量模型挂掉后，多少秒内不再重试（到期自动半开恢复）
# ---------------------------------------------------------------------------
RAG_BREAKER_TTL=30

# ---------------------------------------------------------------------------
# 生成队列（/ask、/ask/stream 在**会生成**时占名额）
# QUEUE_TIMEOUT 必须 > 生成 p50（约 53 s），否则排队者等不到进就超时；
# RETRY_AFTER 用「预期服务时长」而不是超时值，客户端回来时才有空位。
# ---------------------------------------------------------------------------
RAG_MAX_INFLIGHT=1
RAG_MAX_QUEUE=2
RAG_QUEUE_TIMEOUT=120
RAG_RETRY_AFTER=60

# ---------------------------------------------------------------------------
# 检索队列（/retrieve 与生成队列分开：慢的是生成，不该连累检索）
# ---------------------------------------------------------------------------
RAG_RETRIEVE_MAX_INFLIGHT=4
RAG_RETRIEVE_MAX_QUEUE=2
RAG_RETRIEVE_QUEUE_TIMEOUT=5
RAG_RETRIEVE_RETRY_AFTER=1

# ---------------------------------------------------------------------------
# 流式：心跳间隔防反代掐断长连接；请求总时长上限到了就发 504 但保留已发内容
# ---------------------------------------------------------------------------
RAG_HEARTBEAT=15
RAG_REQUEST_TIMEOUT=300

# ---------------------------------------------------------------------------
# 运行日志（JSONL 单文件追加）：level=off 时零成本短路，detail 记 hits 全文
# ---------------------------------------------------------------------------
RAG_LOG_DIR=logs
RAG_LOG_LEVEL=detail
RAG_LOG_TEXT=full
RAG_LOG_SAMPLE=1.0

# ---------------------------------------------------------------------------
# 测试开关：1 = 允许跑连真实 Ollama 的用例（默认 0，整套不联网）
# ---------------------------------------------------------------------------
RAG_OLLAMA_CHECK=0
