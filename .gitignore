# ---- 生成物：不进仓库（可按 README 的命令重新生成）----

# 索引与向量库（可重建：python -m src.build_index）
storage/
# 旧格式单文件索引（若存在）
index.json
embeddings.npy
embeddings.part.npy
.build_progress.json

# 运行日志与 review 报告（每次运行自动生成）
logs/

# 语料（外部资料，按 RAG_DATA_DIR 自备；仓库只提交放置说明，不携带任何文档）
data/*
!data/README.md
!data/.gitkeep

# 评估产物：报告、基线、探针结果都由 measure / 探针脚本生成
experiments/reports/
experiments/probes/
experiments/baseline.json
experiments/baseline_old*.json
# gold_spans→新库 parent 映射明细（可由 python -m src.eval_gold 重新生成，questions.json 里已内嵌）
experiments/gold_points.json
experiments/questions.json.bak

# ---- 工具与缓存 ----

__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/
.env
.DS_Store
Thumbs.db
# D27c 句子候选池（expand_questions_v2 dump 生成，可重建；选中的 span 已内嵌进 questions.json）
experiments/_span_candidates.json
